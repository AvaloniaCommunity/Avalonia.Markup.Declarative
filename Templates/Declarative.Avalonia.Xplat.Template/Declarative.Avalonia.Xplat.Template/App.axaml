<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Declarative.Avalonia.Xplat.Template.App">
    <!-- use the application xaml to load resources and theme -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Declarative.Avalonia.Xplat.Template/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Fluent2Theme />
        <StyleInclude Source="avares://Declarative.Avalonia.Xplat.Template/Styles/CustomStyle.axaml" />
    </Application.Styles>
</Application>
