<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ColorPrimary" Color="#3F1D02" />
  <SolidColorBrush x:Key="ColorOnPrimary" Color="LightGray" />
  <SolidColorBrush x:Key="ColorSecondary" Color="Purple" />
  <SolidColorBrush x:Key="ColorOnSecondary" Color="white" />
</ResourceDictionary>
